<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Info"
      internalLogFile="logs\nlog-internal.log">
    <variable name="logDay" value="${date:format=yyyyMMdd:culture=es}"/>
    <variable name="logName" value="WIS.Database.Setup_${logDay}"/>
    <variable name="logDirectory" value="${basedir}/logs/"/>
    <targets>
        <target xsi:type="File" name="fileTarget" fileName="${logDirectory}/${logName}.log" encoding="utf-8"
				layout="${date}|${level:uppercase=true}|${message} ${exception:format=tostring}"/>
        <target xsi:type="Console"
			  name="consoleTarget"
			  layout="${date}|${level:uppercase=true}|${message} ${exception:format=tostring}|${logger}|${all-event-properties}"
			  encoding="utf-8"
			  detectConsoleAvailable="True"/>
        <target xsi:type="ColoredConsole"
			  name="coloredConsoleTarget"
			  layout="${date}|${level:uppercase=true}|${message} ${exception:format=tostring}"
			  useDefaultRowHighlightingRules="True"
			  encoding="utf-8"
			  detectConsoleAvailable="True" />
    </targets>
    <rules>
        <logger name="*" levels="Error,Info" writeTo="fileTarget,coloredConsoleTarget" />
        <logger name="*" levels="Error,Warn,Info" writeTo="consoleTarget" />
    </rules>
</nlog>
